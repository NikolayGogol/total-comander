{
  "name": "total-commander-windows",
  "productName": "Total Commander",
  "version": "1.0.0",
  "description": "Total Commander orthodox two-pane file manager for Windows built with Node.js, Electron, Vue 3, and SCSS",
  "main": "dist-electron/main.js",
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "app": "vite",
    "build": "vite build",
    "build:win": "vite build && electron-builder --win",
    "build:win:x64": "vite build && electron-builder --win --x64",
    "build:win:arm64": "vite build && electron-builder --win --arm64",
    "build:win:portable": "vite build && electron-builder --win portable --x64",
    "run:prod": "vite build && electron ."
  },
  "keywords": [
    "total-commander",
    "file-manager",
    "windows",
    "vue",
    "electron",
    "scss"
  ],
  "author": "Mikola Gogol",
  "license": "MIT",
  "build": {
    "appId": "com.totalcommander.win",
    "productName": "Total Commander",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "build/icon.ico",
      "build/icon.png"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-Setup-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/installerIcon.ico",
      "uninstallerIcon": "build/uninstallerIcon.ico",
      "installerHeader": "build/installerHeader.bmp",
      "installerHeaderIcon": "build/icon.ico",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/uninstallerSidebar.bmp",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Total Commander",
      "uninstallDisplayName": "Total Commander (Windows Edition)",
      "runAfterFinish": true
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.${ext}"
    }
  },
  "dependencies": {
    "@lucide/vue": "^1.62.0",
    "dayjs": "^1.11.23",
    "lucide-vue-next": "^1.0.0",
    "numeral": "^2.0.6",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/numeral": "^2.0.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "electron": "^41.7.1",
    "electron-builder": "^26.0.12",
    "sass": "^1.106.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-electron": "^1.1.2",
    "vite-plugin-electron-renderer": "^1.0.0"
  }
}
